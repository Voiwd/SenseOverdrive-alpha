[sub_resource type="Shader" id="MembraneShader"]
code = "shader_type spatial;
instance uniform float beat = 0.0;
void fragment() {
	float ribs = 0.5 + 0.5 * cos(UV.y * 50.265);
	ALBEDO = mix(vec3(0.23, 0.015, 0.008), vec3(0.75, 0.12, 0.025), ribs);
	EMISSION = ALBEDO * (0.7 + 2.4 * beat);
	ROUGHNESS = 0.34;
}"

